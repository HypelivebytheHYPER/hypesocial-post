# =============================================================================
# HypeSocial Environment Variables
# Copy this file to .env.local and fill in your values
# Or use: npm run env:sync (pulls from Vercel)
# =============================================================================

# -----------------------------------------------------------------------------
# App Configuration (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://hypesocial-post.vercel.app

# Post For Me API Configuration (Required)
# Get these from your Post For Me dashboard
POST_FOR_ME_API_KEY=your_api_key_here
POST_FOR_ME_API_URL=https://api.postforme.dev/v1

# Post For Me Webhook Secret (Required for receiving webhooks)
# Get this from your Post For Me dashboard webhook settings
# Generate with: openssl rand -hex 32
POST_FOR_ME_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudflare Worker forwarding secret (Required if using worker relay)
# Must match the secret configured in the Cloudflare webhook worker
NEXTJS_WEBHOOK_SECRET=your_nextjs_webhook_secret_here

# Optional: Override redirect URI for OAuth (White Label projects only)
# POST_FOR_ME_REDIRECT_URI=https://your-domain.com/api/accounts/callback

# Optional: Force webhooks to go through Cloudflare Worker instead of direct Vercel
# NEXT_PUBLIC_WEBHOOK_URL=https://api.hypelive.app/webhooks/post-for-me

# Cloudflare AI Agent Configuration (Optional)
# HTTP endpoint for AI chat assistant
CHAT_AGENT_URL=https://chat-agent.hypelive.workers.dev

# -----------------------------------------------------------------------------
# OAuth Webhook (Optional but recommended)
# -----------------------------------------------------------------------------
# Secret for verifying OAuth webhook callbacks
# Generate with: openssl rand -hex 32
OAUTH_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# Lark Base (the project's database — via lark-http-hype worker)
# -----------------------------------------------------------------------------
# The worker URL exposes the Lark Open API as a single REST endpoint.
# All database traffic from the Next.js app goes through this URL via
# lib/lark.ts (SSOT client). See docs/ENVIRONMENT_VARIABLES.md for the
# full schema of each table below.
LARK_HTTP_WORKER_URL=https://lark-http-hype.hypelive.workers.dev
LARK_APP_TOKEN=your_lark_base_app_token     # tblXXXXXXXXXXX workspace token

# Optional bearer for the worker (if API_KEY secret enabled on the worker)
# LARK_API_KEY=your_worker_bearer_token

# Table IDs (tblXXXXXXXXXXXXXX) — never expose with NEXT_PUBLIC_ prefix
LARK_EVENTS_TABLE_ID=your_events_table_id
LARK_BUILDER_TEMPLATES_TABLE_ID=your_builder_templates_table_id

# Canva catalog tables (only needed if Canva integration is enabled)
# LARK_TABLE_ID_CANVA_CAMPAIGNS=your_canva_campaigns_table_id
# LARK_TABLE_ID_CANVA_PRODUCTS=your_canva_products_table_id
# LARK_TABLE_ID_CANVA_PAGES=your_canva_pages_table_id

# -----------------------------------------------------------------------------
# Lark Bot (separate from Base — uses @larksuiteoapi/node-sdk directly)
# -----------------------------------------------------------------------------
# Only needed if you're running the bot (lib/lark-bot.ts). The Base/database
# integration above works without these.
# LARK_BOT_APP_ID=your_lark_bot_app_id
# LARK_BOT_APP_SECRET=your_lark_bot_app_secret
# LARK_SUPPORT_CHAT_ID=your_support_chat_id

# -----------------------------------------------------------------------------
# Canva Connect API Configuration (Optional)
# -----------------------------------------------------------------------------
# Get these from https://www.canva.com/developers/apps/
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
# Generate with: openssl rand -hex 32
CANVA_COOKIE_SECRET=your_canva_cookie_secret_at_least_32_chars

# -----------------------------------------------------------------------------
# Figma Integration (Optional)
# -----------------------------------------------------------------------------
# Get your token from Figma → Settings → Personal access tokens
FIGMA_ACCESS_TOKEN=your_figma_token_here

# -----------------------------------------------------------------------------
# Penpot Integration (Optional)
# -----------------------------------------------------------------------------
# Supports both SaaS (design.penpot.app) and self-hosted instances
PENPOT_BASE_URL=https://design.penpot.app
PENPOT_API_TOKEN=your_penpot_access_token_here

# -----------------------------------------------------------------------------
# Image Processing (Optional)
# -----------------------------------------------------------------------------
# REMOVE_BG_API_KEY=your_remove_bg_api_key
# CLOUDINARY_CLOUD_NAME=your_cloud_name

# -----------------------------------------------------------------------------
# AI Image Generation (Optional)
# -----------------------------------------------------------------------------
# Option A: OpenAI DALL-E 3
# OPENAI_API_KEY=your_openai_api_key
# Option B: Generic OpenAI-compatible provider (e.g., BytePlus Ark, Volcengine, custom)
# IMAGE_GEN_API_URL=https://your-provider.com/v1/images/generations
# IMAGE_GEN_API_KEY=your_provider_api_key
# IMAGE_GEN_MODEL=dall-e-3

# -----------------------------------------------------------------------------
# Freepik Integration (Optional)
# -----------------------------------------------------------------------------
# Get your API Key at: freepik.com/api
FREEPIK_API_KEY=your_freepik_api_key_here

# -----------------------------------------------------------------------------
# Vercel Environment (Auto-set by Vercel)
# -----------------------------------------------------------------------------
# VERCEL_URL=your-project.vercel.app
# VERCEL_ENV=production
