# Post For Me API (Required)
POST_FOR_ME_API_KEY=your_api_key_here
POST_FOR_ME_BASE_URL=https://api.postforme.dev
POST_FOR_ME_WEBHOOK_SECRET=your_webhook_secret

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ================================================================
# Lark Base — primary database (NOT Supabase / NOT Postgres)
# ================================================================

# Lark workspace credentials
LARK_APP_TOKEN=your_lark_app_token
LARK_HTTP_WORKER_URL=https://lark-http-hype.hypelive.workers.dev
# Optional Bearer key for the worker if it has API_KEY secret enabled
LARK_API_KEY=

# EVENTS table — unified webhook event bus (REQUIRED for SSE realtime)
# Schema: see ENVIRONMENT_VARIABLES.md → "Lark EVENTS table"
LARK_EVENTS_TABLE_ID=your_events_table_id

# Auth — NextAuth credentials provider reads from this Lark table
LARK_USERS_TABLE_ID=your_users_table_id

# Forwarded Account Connection (Optional)
# Post For Me's callback base URL — enables OAuth interception.
# When set, auth URLs route through /api/accounts/callback/[platform] before forwarding to PFM.
# Example: https://app.postforme.dev/callback (we append /{platform}/account)
POST_FOR_ME_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Webhook endpoint URL (Cloudflare Worker that relays to this app)
NEXT_PUBLIC_WEBHOOK_URL=https://api.hypelive.app/webhooks/post-for-me

# Perplexity AI (Optional - for MCP)
PERPLEXITY_API_KEY=your_perplexity_key

# E2E Testing (Optional - for Playwright tests)
# URL to test against (defaults to http://localhost:3000)
E2E_BASE_URL=http://localhost:3000

# Test credentials for authenticated E2E tests
# These should match a user in your Lark Users table
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=your-test-password
