{
  "mcpServers": {
    "figma": {
      "name": "Figma",
      "command": "npx",
      "args": ["-y", "@figma/mcp-server@latest"],
      "env": {
        "FIGMA_API_TOKEN": "${env:FIGMA_API_TOKEN}"
      }
    },
    "shadcn-studio": {
      "name": "Shadcn Studio",
      "command": "npx",
      "args": ["-y", "@shadcnstudio/mcp@latest"]
    },
    "penpot": {
      "name": "Penpot",
      "transport": "http",
      "url": "https://design.penpot.app/mcp/stream?userToken=${env:PENPOT_MCP_TOKEN}"
    },
    "canva": {
      "name": "Canva",
      "transport": "http",
      "url": "https://mcp.canva.com/mcp"
    }
  }
}
